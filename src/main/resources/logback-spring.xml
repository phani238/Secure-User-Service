<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="logback-spring.dtd"?>
<configuration>
	<appender name="CONSOLE"
		class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level
				[cid=%X{correlationId}] [%thread] %logger{36} - %msg%n</pattern>
		</encoder>

	</appender>
	<logger name="com.example.secureservice" level="DEBUG" />
	<root level="INFO">
		<appender-ref ref="CONSOLE" />
	</root>

</configuration>